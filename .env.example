# rva.guru's Supabase project (Clique shares login with rva.guru)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public origin used for magic-link redirects, e.g. https://rva.guru
NEXT_PUBLIC_SITE_URL=

# Disabled until approved schema deployment, auth E2E and domain configuration
CLIQUE_ACCOUNT_LINKING_ENABLED=false
# GANG server secret from approved secret vault; never prefix with NEXT_PUBLIC_
CLIQUE_LINK_SERVICE_ROLE_KEY=
CLIQUE_LINK_SECRET=
# Explicit HTTPS browser Origins (comma-separated): https://rva.guru,https://your-preview-host.example
CLIQUE_LINK_ALLOWED_ORIGINS=
# Trusted HOMIES frontend root (e.g. https://homies1.vercel.app)
CLIQUE_HOMIES_LINK_ORIGIN=
# Fixed return origin (e.g. https://rva.guru)
CLIQUE_PUBLIC_RETURN_ORIGIN=
